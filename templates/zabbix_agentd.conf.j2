#
# ANSIBLE MANAGED FILE
# DO NOT EDIT BY HAND!!!
#

PidFile=/run/zabbix/zabbix_agent2.pid
LogFile=/var/log/zabbix/zabbix_agent2.log
LogFileSize=0
PluginSocket=/run/zabbix/agent.plugin.sock
ControlSocket=/run/zabbix/agent.sock

Server={{ ansible_zabbix_agent__ServerAddr }}
ServerActive={{ ansible_zabbix_agent__ServerAddr }}

Timeout={{ ansible_zabbix_agent__Timeout }}
RefreshActiveChecks={{ ansible_zabbix_agent__RefrechActiveChecksTime  }}

{% if ansible_facts["architecture"] == "x86_64" %}
DenyKey=system.run[*]
{% endif %}

{% if ansible_zabbix_agent__Hostname is defined %}
Hostname={{ ansible_zabbix_agent__Hostname }}
{% endif %}


Include=/etc/zabbix/zabbix_agent2.d/*.conf
Include=/etc/zabbix/zabbix_agent2.d/plugins.d/*.conf

